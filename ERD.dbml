// ============================================================================
// "여기몰까" 데이터베이스 ERD (dbdiagram.io 형식)
// ============================================================================
// 최신 마이그레이션까지 반영된 최신 스키마
// 
// 적용된 마이그레이션:
// - 001: 테이블 네이밍 리팩토링 (reports→shop_reports, ratings→shop_ratings 등)
// - 002: 인덱스 구조 최적화 (복합 인덱스 추가)
// - 003: NULL 처리 전략 개선 (익명 사용자 도입, user_id NOT NULL)
// - 004: CASCADE 전략 재고 (ON DELETE CASCADE → ON DELETE RESTRICT)
// - 005: ENUM 도입 (verification_source_enum)
// - add_evidence_files: shop_reports.evidence_files 컬럼 추가
// - add_shop_tracking_and_search_logs: shops 추적 컬럼 및 shop_search_logs 테이블 추가
// ============================================================================

// ========= Users & Auth =========

Table users {
  id bigserial [pk, increment]
  username varchar [unique, not null]
  email varchar [unique, not null]
  password varchar [not null]
  phone_number varchar [unique, not null]
  status varchar [note: 'active, unregistered, deleted, anonymous - 마이그레이션 004: CASCADE 전략 재고']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  indexes {
    email [name: 'idx_users_email']
    phone_number [name: 'idx_users_phone_number']
    created_at [name: 'idx_users_created_at']
  }
}

Table password_reset_tokens {
  id bigserial [pk, increment]
  user_id bigint [ref: > users.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  token varchar [unique, not null]
  expires_at timestamptz [not null]
  used boolean [default: false]
  created_at timestamptz [default: `now()`]
  
  indexes {
    token [name: 'idx_password_reset_tokens_token']
    user_id [name: 'idx_password_reset_tokens_user_id']
    expires_at [name: 'idx_password_reset_tokens_expires_at']
  }
}

// ========= Shops & Reports/Ratings =========

Table shops {
  id bigserial [pk, increment]
  url varchar(500) [unique, not null, note: '정규화된 URL']
  name varchar
  parent_shop_id bigint [ref: > shops.id, note: '자기 참조: 부모 쇼핑몰, ON DELETE RESTRICT - 마이그레이션 004, CHECK: parent_shop_id != id (순환 참조 방지)']
  search_count integer [default: 0]
  created_by_user_id bigint [ref: - users.id, note: '쇼핑몰을 생성한 사용자, ON DELETE SET NULL - 마이그레이션: add_shop_tracking_and_search_logs']
  created_via varchar(50) [note: 'report, rating, admin, search 등 - 마이그레이션: add_shop_tracking_and_search_logs']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  indexes {
    url [name: 'idx_shops_url']
    parent_shop_id [name: 'idx_shops_parent_shop_id']
    created_by_user_id [name: 'idx_shops_created_by_user_id']
    created_via [name: 'idx_shops_created_via']
    created_at [name: 'idx_shops_created_at_date']
    search_count [name: 'idx_shops_search_count']
  }
}

Table shop_reports {
  id bigserial [pk, increment]
  shop_id bigint [ref: > shops.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  user_id bigint [ref: > users.id, not null, note: 'NOT NULL - 마이그레이션 003: NULL 처리 전략 개선, ON DELETE RESTRICT - 마이그레이션 004']
  reporter_name varchar
  reporter_phone varchar(20)
  categories text [not null]
  description text [not null]
  evidence_type varchar(50) [default: 'NONE']
  evidence_files text [note: 'JSON 배열 형식 - 마이그레이션: add_evidence_files']
  evidence_verified boolean [default: false]
  verification_score integer [default: 0]
  report_type varchar(50) [default: 'GENERAL_REVIEW']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  indexes {
    shop_id [name: 'idx_shop_reports_shop_id']
    user_id [name: 'idx_shop_reports_user_id']
    created_at [name: 'idx_shop_reports_created_at']
    evidence_type [name: 'idx_shop_reports_evidence_type']
    report_type [name: 'idx_shop_reports_report_type']
    verification_score [name: 'idx_shop_reports_verification_score']
    (shop_id, report_type) [name: 'idx_shop_reports_shop_id_status', note: '마이그레이션 002: 인덱스 구조 최적화']
  }
}

Table shop_ratings {
  id bigserial [pk, increment]
  shop_id bigint [ref: > shops.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  user_id bigint [ref: > users.id, not null, note: 'NOT NULL - 마이그레이션 003: NULL 처리 전략 개선, ON DELETE RESTRICT - 마이그레이션 004']
  rating integer [not null, note: 'CHECK: rating >= 1 AND rating <= 5']
  comment text
  created_at timestamptz [default: `now()`]
  
  indexes {
    shop_id [name: 'idx_shop_ratings_shop_id']
    user_id [name: 'idx_shop_ratings_user_id']
    created_at [name: 'idx_shop_ratings_created_at']
    rating [name: 'idx_shop_ratings_rating']
    (shop_id, rating) [name: 'idx_shop_ratings_shop_id_rating', note: '마이그레이션 002: 인덱스 구조 최적화']
  }
}

Table report_evidence_attachments {
  id bigserial [pk, increment]
  report_id bigint [ref: > shop_reports.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  file_name varchar(255) [not null]
  file_path varchar(500) [not null]
  file_size bigint [not null]
  file_type varchar(100) [not null]
  upload_date timestamptz [default: `now()`]
  verification_status varchar(20) [default: 'PENDING', note: 'PENDING, VERIFIED, REJECTED']
  
  indexes {
    report_id [name: 'idx_report_evidence_attachments_report_id']
  }
}

Table shop_search_logs {
  id bigserial [pk, increment]
  normalized_url varchar(255) [not null]
  raw_url text
  user_id bigint [ref: - users.id, note: 'ON DELETE SET NULL - 마이그레이션: add_shop_tracking_and_search_logs']
  ip_address varchar(64)
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    normalized_url [name: 'idx_shop_search_logs_normalized_url']
    user_id [name: 'idx_shop_search_logs_user_id']
    created_at [name: 'idx_shop_search_logs_created_at']
  }
}

// ========= SMS =========

Table sms_verifications {
  id bigserial [pk, increment]
  phone_number varchar(20) [not null]
  verification_code varchar(10) [not null]
  is_verified boolean [default: false]
  expires_at timestamptz
  created_at timestamptz [default: `now()`]
  
  indexes {
    phone_number [name: 'idx_sms_verifications_phone']
    verification_code [name: 'idx_sms_verifications_code']
  }
}

Table sms_request_logs {
  id bigserial [pk, increment]
  phone_number varchar(20) [not null]
  ip_address inet
  sent_count integer [default: 1]
  last_sent_at timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  indexes {
    phone_number [name: 'idx_sms_request_logs_phone']
    ip_address [name: 'idx_sms_request_logs_ip']
  }
}

// ========= Community =========

Table community_posts {
  id bigserial [pk, increment]
  user_id bigint [ref: > users.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  title varchar(100) [not null]
  content text [not null]
  views integer [default: 0]
  likes integer [default: 0]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  indexes {
    user_id [name: 'idx_community_posts_user_id']
    created_at [name: 'idx_community_posts_created_at']
  }
}

Table community_comments {
  id bigserial [pk, increment]
  post_id bigint [ref: > community_posts.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  user_id bigint [ref: > users.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  content varchar(500) [not null]
  created_at timestamptz [default: `now()`]
  
  indexes {
    post_id [name: 'idx_community_comments_post_id']
    user_id [name: 'idx_community_comments_user_id']
  }
}

Table community_post_likes {
  id bigserial [pk, increment]
  post_id bigint [ref: > community_posts.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004, UNIQUE(post_id, user_id) - 중복 좋아요 방지']
  user_id bigint [ref: > users.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  created_at timestamptz [default: `now()`]
  
  indexes {
    post_id [name: 'idx_community_post_likes_post_id']
    user_id [name: 'idx_community_post_likes_user_id']
  }
}

// ========= Analysis & Biz Reg =========

Table ai_analysis_cache_entries {
  id bigserial [pk, increment]
  shop_id bigint [ref: > shops.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  analysis_type varchar(50) [not null, note: 'RISK_ANALYSIS, BUSINESS_ANALYSIS, WEB_ANALYSIS 등']
  analysis_result text [not null, note: 'JSON 형태']
  analysis_date timestamptz [default: `now()`]
  expires_at timestamptz [not null]
  created_at timestamptz [default: `now()`]
  
  indexes {
    shop_id [name: 'idx_ai_analysis_cache_entries_shop_id']
    expires_at [name: 'idx_ai_analysis_cache_entries_expires_at']
    analysis_type [name: 'idx_ai_analysis_cache_entries_type']
  }
}

Table web_analysis_results {
  id bigserial [pk, increment]
  shop_id bigint [ref: > shops.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  suspicious_keywords text [note: 'JSON 형태']
  price_analysis text [note: 'JSON 형태']
  technical_analysis text [note: 'JSON 형태']
  domain_analysis text [note: 'JSON 형태']
  analysis_date timestamptz [default: `now()`]
  analysis_source varchar(50) [default: 'AUTO', note: 'AUTO, MANUAL']
  confidence_score integer [default: 0, note: '0-100']
  created_at timestamptz [default: `now()`]
  
  indexes {
    shop_id [name: 'idx_web_analysis_results_shop_id']
    analysis_date [name: 'idx_web_analysis_results_analysis_date']
  }
}

Table business_registrations {
  id bigserial [pk, increment]
  shop_id bigint [ref: > shops.id, not null, note: 'ON DELETE RESTRICT - 마이그레이션 004']
  business_number varchar(20)
  registration_date date
  business_status varchar(20) [default: 'UNKNOWN', note: 'ACTIVE, SUSPENDED, CLOSED, UNKNOWN']
  business_type varchar(100)
  capital_amount bigint
  representative_name varchar(100)
  business_address text
  phone_number varchar(20)
  email varchar(255)
  last_verified timestamptz [default: `now()`]
  verification_source varchar [note: 'ENUM 타입 (verification_source_enum): API, MANUAL, CRAWLING - 마이그레이션 005: ENUM 도입, 기본값: MANUAL']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  
  indexes {
    shop_id [name: 'idx_business_registrations_shop_id']
    business_number [name: 'idx_business_registrations_business_number']
    business_status [name: 'idx_business_registrations_business_status']
  }
}

