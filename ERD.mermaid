erDiagram

    %% ========= Users & Auth =========

    users {
        bigserial id
        varchar   username
        varchar   email
        varchar   password
        varchar   phone_number
        timestamptz created_at
        timestamptz updated_at
    }

    password_reset_tokens {
        bigserial id
        bigint    user_id
        varchar   token
        timestamptz expires_at
        boolean   used
        timestamptz created_at
    }

    %% ========= Shops & Reports/Ratings =========

    shops {
        bigserial id
        varchar   url
        varchar   name
        bigint    parent_shop_id "FK: shops.id (자기 참조)"
        integer   search_count
        timestamptz created_at
        timestamptz updated_at
    }

    reports {
        bigserial id
        bigint    shop_id
        bigint    user_id
        varchar   reporter_name
        varchar   reporter_phone
        text      categories
        text      description
        varchar   evidence_type
        text      evidence_files
        boolean   evidence_verified
        integer   verification_score
        varchar   report_type
        timestamptz created_at
        timestamptz updated_at
    }

    ratings {
        bigserial id
        bigint    shop_id
        bigint    user_id
        integer   rating
        text      comment
        timestamptz created_at
    }

    uploaded_files {
        bigserial id
        bigint    report_id
        varchar   file_name
        varchar   file_path
        bigint    file_size
        varchar   file_type
        timestamptz upload_date
        varchar   verification_status
    }

    %% ========= SMS =========

    sms_verifications {
        bigserial id
        varchar   phone_number
        varchar   verification_code
        boolean   is_verified
        timestamptz expires_at
        timestamptz created_at
    }

    sms_request_tracking {
        bigserial id
        varchar   phone_number
        inet      ip_address
        integer   sent_count
        timestamptz last_sent_at
        timestamptz created_at
        timestamptz updated_at
    }

    %% ========= Community =========

    community_posts {
        bigserial id
        bigint    user_id
        varchar   title
        text      content
        integer   views
        integer   likes
        timestamptz created_at
        timestamptz updated_at
    }

    community_comments {
        bigserial id
        bigint    post_id
        bigint    user_id
        varchar   content
        timestamptz created_at
    }

    community_post_likes {
        bigserial id
        bigint    post_id
        bigint    user_id
        timestamptz created_at
    }

    %% ========= Analysis & Biz Reg =========

    ai_analysis_cache {
        bigserial id
        bigint    shop_id
        varchar   analysis_type
        text      analysis_result
        timestamptz analysis_date
        timestamptz expires_at
        timestamptz created_at
    }

    web_analysis {
        bigserial id
        bigint    shop_id
        text      suspicious_keywords
        text      price_analysis
        text      technical_analysis
        text      domain_analysis
        timestamptz analysis_date
        varchar   analysis_source
        integer   confidence_score
        timestamptz created_at
    }

    business_registrations {
        bigserial id
        bigint    shop_id
        varchar   business_number
        date      registration_date
        varchar   business_status
        varchar   business_type
        bigint    capital_amount
        varchar   representative_name
        text      business_address
        varchar   phone_number
        varchar   email
        timestamptz last_verified
        varchar   verification_source
        timestamptz created_at
        timestamptz updated_at
    }

    %% ========= Relationships =========

    %% Users 관계
    users ||--o{ password_reset_tokens : has
    users ||--o{ community_posts      : writes
    users ||--o{ community_comments   : comments
    users ||--o{ community_post_likes : likes
    users ||--o{ reports              : files
    users ||--o{ ratings              : rates

    %% Shops 관계
    shops ||--o{ reports              : has
    shops ||--o{ ratings              : receives
    shops ||--o{ ai_analysis_cache    : analyzed_in
    shops ||--o{ web_analysis         : analyzed_in
    shops ||--o| business_registrations : has_one
    
    %% ========= Shops 자기 참조 (Self-Referencing Relationship) =========
    %% 중요: Mermaid ERD에서 자기 참조는 루프 형태로 표시됩니다
    %% 관계: shops.parent_shop_id → shops.id (FK)
    %% 의미: 자식 쇼핑몰이 부모 쇼핑몰을 참조 (N:1)
    %% 카디널리티: 부모 쇼핑몰 1개가 여러 자식 쇼핑몰을 가질 수 있음
    %% 예시: smartstore.naver.com/main (부모) ← smartstore.naver.com/branch1 (자식)
    shops ||--o{ shops : parent_of

    %% Reports 관계
    reports ||--o{ uploaded_files     : evidence

    %% Community 관계
    community_posts ||--o{ community_comments : has
    community_posts ||--o{ community_post_likes : has

    %% SMS 관계 (논리적 연결: phone_number 기반)
    %% 참고: 외래키 제약조건은 없지만, phone_number로 논리적으로 연결됨
    %% 인증 완료 전에는 user가 존재하지 않을 수 있으므로 의도적 설계
    users ||--o{ sms_verifications    : "verifies (phone_number)"
    users ||--o{ sms_request_tracking : "tracks (phone_number)"

