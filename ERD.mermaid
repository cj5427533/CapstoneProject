%% ============================================================================
%% "여기몰까" 데이터베이스 ERD (Mermaid 형식)
%% ============================================================================
%% 실제 데이터베이스 스키마에 맞춘 최신 ERD
%% 
%% 적용된 마이그레이션:
%% - add_evidence_files: reports.evidence_files 컬럼 추가
%% - add_shop_tracking_and_search_logs: shops 추적 컬럼 및 shop_search_logs 테이블 추가
%% - add_user_login_logs: user_login_logs 테이블 추가 및 users.last_login_at 컬럼 추가
%% ============================================================================

erDiagram
    %% ========= Users & Auth =========
    
    users {
        bigint id PK
        string username "unique, NOT NULL"
        string email "unique, NOT NULL"
        string password "NOT NULL"
        string phone_number "unique, NOT NULL"
        timestamp created_at
        timestamp updated_at
        timestamp last_login_at
    }
    
    password_reset_tokens {
        bigint id PK
        bigint user_id FK "NOT NULL"
        string token "unique, NOT NULL"
        timestamp expires_at "NOT NULL"
        bool used
        timestamp created_at
    }
    
    user_login_logs {
        bigint id PK
        bigint user_id FK "NOT NULL"
        string ip_address
        string user_agent
        bool login_success
        string failure_reason "INVALID_PASSWORD, USER_NOT_FOUND, ACCOUNT_DELETED 등"
        timestamp created_at
    }
    
    %% ========= Shops & Reports/Ratings =========
    
    shops {
        bigint id PK
        string url "unique, NOT NULL, 정규화된 URL"
        string name
        bigint parent_shop_id FK "자기 참조: 부모 쇼핑몰"
        int search_count
        bigint created_by_user_id FK "ON DELETE SET NULL"
        string created_via "report, rating, admin, search 등"
        timestamp created_at
        timestamp updated_at
    }
    
    reports {
        bigint id PK
        bigint shop_id FK "NOT NULL"
        bigint user_id FK "ON DELETE SET NULL, 선택적"
        string reporter_name
        string reporter_phone
        string categories "NOT NULL"
        string description "NOT NULL"
        string evidence_type "default: NONE"
        string evidence_files "JSON 배열 형식"
        bool evidence_verified
        int verification_score
        string report_type "default: GENERAL_REVIEW"
        timestamp created_at
        timestamp updated_at
    }
    
    ratings {
        bigint id PK
        bigint shop_id FK "NOT NULL"
        bigint user_id FK "ON DELETE SET NULL, 선택적"
        int rating "NOT NULL, CHECK: rating >= 1 AND rating <= 5"
        string comment
        timestamp created_at
    }
    
    uploaded_files {
        bigint id PK
        bigint report_id FK "NOT NULL"
        string file_name "NOT NULL"
        string file_path "NOT NULL"
        bigint file_size "NOT NULL"
        string file_type "NOT NULL"
        timestamp upload_date
        string verification_status "PENDING, VERIFIED, REJECTED"
    }
    
    shop_search_logs {
        bigint id PK
        string normalized_url "NOT NULL"
        string raw_url
        bigint user_id FK "ON DELETE SET NULL"
        string ip_address
        string user_agent
        timestamp created_at "NOT NULL"
    }
    
    %% ========= SMS =========
    
    sms_verifications {
        bigint id PK
        string phone_number "NOT NULL"
        string verification_code "NOT NULL"
        bool is_verified
        timestamp expires_at
        timestamp created_at
    }
    
    sms_request_tracking {
        bigint id PK
        string phone_number "NOT NULL"
        string ip_address "INET 타입"
        int sent_count
        timestamp last_sent_at
        timestamp created_at
        timestamp updated_at
    }
    
    %% ========= Community =========
    
    community_posts {
        bigint id PK
        bigint user_id FK "NOT NULL"
        string title "NOT NULL"
        string content "NOT NULL"
        int views
        int likes
        timestamp created_at
        timestamp updated_at
    }
    
    community_comments {
        bigint id PK
        bigint post_id FK "NOT NULL"
        bigint user_id FK "NOT NULL"
        string content "NOT NULL"
        timestamp created_at
    }
    
    community_post_likes {
        bigint id PK
        bigint post_id FK "NOT NULL, UNIQUE(post_id, user_id)"
        bigint user_id FK "NOT NULL, UNIQUE(post_id, user_id)"
        timestamp created_at
    }
    
    %% ========= Analysis & Biz Reg =========
    
    ai_analysis_cache {
        bigint id PK
        bigint shop_id FK "NOT NULL"
        string analysis_type "NOT NULL, RISK_ANALYSIS, BUSINESS_ANALYSIS, WEB_ANALYSIS 등"
        string analysis_result "NOT NULL, JSON 형태"
        timestamp analysis_date
        timestamp expires_at "NOT NULL"
        timestamp created_at
    }
    
    web_analysis {
        bigint id PK
        bigint shop_id FK "NOT NULL"
        string suspicious_keywords "JSON 형태"
        string price_analysis "JSON 형태"
        string technical_analysis "JSON 형태"
        string domain_analysis "JSON 형태"
        timestamp analysis_date
        string analysis_source "AUTO, MANUAL"
        int confidence_score "0-100"
        timestamp created_at
    }
    
    business_registrations {
        bigint id PK
        bigint shop_id FK "NOT NULL"
        string business_number
        date registration_date
        string business_status "ACTIVE, SUSPENDED, CLOSED, UNKNOWN"
        string business_type
        bigint capital_amount
        string representative_name
        string business_address
        string phone_number
        string email
        timestamp last_verified
        string verification_source "API, MANUAL, CRAWLING"
        timestamp created_at
        timestamp updated_at
    }
    
    %% ========= Relationships =========
    
    %% Users & Auth
    users ||--o{ password_reset_tokens : "has"
    users ||--o{ user_login_logs : "has"
    
    %% Shops & Reports/Ratings
    shops ||--o{ shops : "parent_shop"
    users }o--o{ shops : "created_by"
    shops ||--o{ reports : "has"
    users }o--o{ reports : "reports"
    shops ||--o{ ratings : "has"
    users }o--o{ ratings : "rates"
    reports ||--o{ uploaded_files : "has"
    users }o--o{ shop_search_logs : "searches"
    
    %% Community
    users ||--o{ community_posts : "writes"
    community_posts ||--o{ community_comments : "has"
    users ||--o{ community_comments : "comments"
    community_posts ||--o{ community_post_likes : "has"
    users ||--o{ community_post_likes : "likes"
    
    %% Analysis & Biz Reg
    shops ||--o{ ai_analysis_cache : "has"
    shops ||--o{ web_analysis : "has"
    shops ||--o{ business_registrations : "has"
