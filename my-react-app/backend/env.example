# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://tqdvolgachfszomwhlfe.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AWS Configuration (if needed)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# SMS 서비스 설정 (SolAPI만 사용)
# development: 개발 모드 (실제 SMS 발송 없음)
# solapi: SolAPI 사용 (실제 SMS 발송)
SMS_PROVIDER=solapi

# SolAPI 설정 (사업자 인증 없이 사용 가능)
# 1. https://solapi.com 회원가입
# 2. API 키 발급 (개인 인증으로 가능)
# 3. 무료 크레딧 제공
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
SOLAPI_FROM_NUMBER=01012345678

# Gmail SMTP 설정 (비밀번호 재설정 이메일)
# 1. Gmail 계정 설정 → 보안 → 2단계 인증 활성화
# 2. 앱 비밀번호 생성 (16자리)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log