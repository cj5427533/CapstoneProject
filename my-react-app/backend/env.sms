# SMS 서비스 연동을 위한 환경 변수 설정
# 실제 SMS 발송을 위해서는 아래 값들을 유효한 값으로 변경하세요

# SolAPI 설정 (https://solapi.com/)
SOLAPI_KEY=your_solapi_key_here
SOLAPI_SECRET=your_solapi_secret_here
SOLAPI_FROM_NUMBER=01012345678

# 다른 SMS 서비스 사용 시
# 알리고 (https://www.aligo.in/)
# ALIGO_API_KEY=your_aligo_key_here
# ALIGO_USER_ID=your_aligo_user_id_here
# ALIGO_SENDER=01012345678

# 비즈고 (https://www.bizgo.io/)
# BIZGO_API_KEY=your_bizgo_key_here
# BIZGO_SENDER=01012345678

# 실제 SMS 발송을 활성화하려면:
# 1. 위의 환경 변수들을 유효한 값으로 설정
# 2. server.js에서 smsProvider를 'solapi'로 변경
# 3. 서버 재시작
