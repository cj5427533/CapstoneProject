%% ============================================================================
%% "여기몰까" 데이터베이스 ERD (Mermaid 형식)
%% ============================================================================
%% 실제 데이터베이스 스키마에 맞춘 최신 ERD
%% 기준: complete-schema.sql (2024)
%% 최종 업데이트: 2025년 1월
%% 
%% 적용된 마이그레이션:
%% - add_evidence_files: reports.evidence_files 컬럼 추가
%% - add_user_login_logs: user_login_logs 테이블 추가 및 users.last_login_at 컬럼 추가
%% - add_sms_table_relationships: sms_verifications와 sms_request_tracking 테이블 관계 설정
%% - 인덱스 최적화: 불필요한 인덱스 8개 제거 (카디널리티 낮은 인덱스, 사용 빈도 낮은 인덱스)
%% 
%% 참고: 
%% - shop_search_logs는 코드에서 사용 중이나 스키마 파일에는 없음 (별도 관리)
%% - shop_trust_scores, ml_prediction_results, sms_request_logs는 코드에서 사용 중
%% - reports 테이블에 status 컬럼 추가 (pending|approved|rejected) - 마이그레이션 필요
%% ============================================================================

erDiagram
    %% ========= Users & Auth =========
    
    users {
        bigint id PK
        string username "unique, NOT NULL"
        string email "unique, NOT NULL"
        string password "NOT NULL"
        string phone_number "unique, NOT NULL"
        timestamp created_at
        timestamp updated_at
        timestamp last_login_at
    }
    
    password_reset_tokens {
        bigint id PK
        bigint user_id FK "NOT NULL, ON DELETE CASCADE"
        string token "unique, NOT NULL"
        timestamp expires_at "NOT NULL"
        bool used "default: FALSE"
        timestamp created_at
    }
    
    user_login_logs {
        bigint id PK
        bigint user_id FK "NOT NULL, ON DELETE CASCADE"
        string ip_address
        text user_agent
        bool login_success "default: TRUE"
        string failure_reason "INVALID_PASSWORD, USER_NOT_FOUND, ACCOUNT_DELETED 등"
        timestamp created_at
    }
    
    %% ========= Shops & Reports/Ratings =========
    
    shops {
        bigint id PK
        string url "unique, NOT NULL, 정규화된 URL"
        string name
        bigint parent_shop_id FK "자기 참조: 부모 쇼핑몰, CHECK: parent_shop_id != id"
        int search_count "default: 0"
        timestamp created_at
        timestamp updated_at
    }
    
    shop_search_logs {
        bigint id PK
        string normalized_url "NOT NULL"
        text raw_url
        bigint user_id FK "ON DELETE SET NULL, 선택적"
        string ip_address
        text user_agent
        timestamp created_at "NOT NULL"
    }
    
    reports {
        bigint id PK
        bigint shop_id FK "NOT NULL, ON DELETE CASCADE"
        bigint user_id FK "ON DELETE SET NULL, 선택적"
        string reporter_name
        string reporter_phone
        text categories "NOT NULL"
        text description "NOT NULL"
        string evidence_type "default: NONE"
        text evidence_files "JSON 배열 형식"
        bool evidence_verified "default: FALSE"
        int verification_score "default: 0"
        string report_type "default: GENERAL_REVIEW"
        string status "default: pending, pending|approved|rejected"
        timestamp created_at
        timestamp updated_at
    }
    
    ratings {
        bigint id PK
        bigint shop_id FK "NOT NULL, ON DELETE CASCADE"
        bigint user_id FK "ON DELETE SET NULL, 선택적"
        int rating "NOT NULL, CHECK: rating >= 1 AND rating <= 5"
        text comment
        timestamp created_at
    }
    
    uploaded_files {
        bigint id PK
        bigint report_id FK "NOT NULL, ON DELETE CASCADE"
        string file_name "NOT NULL"
        string file_path "NOT NULL"
        bigint file_size "NOT NULL"
        string file_type "NOT NULL"
        timestamp upload_date
        string verification_status "default: PENDING, PENDING|VERIFIED|REJECTED"
    }
    
    %% ========= SMS =========
    
    sms_verifications {
        bigint id PK
        string phone_number "NOT NULL"
        string verification_code "NOT NULL"
        bool is_verified "default: FALSE"
        timestamp expires_at
        bigint user_id FK "ON DELETE SET NULL, 선택적"
        bigint sms_request_tracking_id FK "ON DELETE SET NULL, 선택적"
        timestamp created_at
    }
    
    sms_request_tracking {
        bigint id PK
        string phone_number "NOT NULL"
        inet ip_address "INET 타입"
        int sent_count "default: 1"
        timestamp last_sent_at
        bigint user_id FK "ON DELETE SET NULL, 선택적"
        timestamp created_at
        timestamp updated_at
    }
    
    sms_request_logs {
        bigint id PK
        string phone_number "NOT NULL"
        inet ip_address
        int sent_count "default: 1"
        timestamp last_sent_at
        timestamp updated_at
    }
    
    %% ========= Community =========
    
    community_posts {
        bigint id PK
        bigint user_id FK "NOT NULL, ON DELETE CASCADE"
        string title "NOT NULL, VARCHAR(100)"
        text content "NOT NULL"
        int views "default: 0"
        int likes "default: 0"
        timestamp created_at
        timestamp updated_at
    }
    
    community_comments {
        bigint id PK
        bigint post_id FK "NOT NULL, ON DELETE CASCADE"
        bigint user_id FK "NOT NULL, ON DELETE CASCADE"
        string content "NOT NULL, VARCHAR(500)"
        timestamp created_at
    }
    
    community_post_likes {
        bigint id PK
        bigint post_id FK "NOT NULL, ON DELETE CASCADE, UNIQUE(post_id, user_id)"
        bigint user_id FK "NOT NULL, ON DELETE CASCADE, UNIQUE(post_id, user_id)"
        timestamp created_at
    }
    
    %% ========= Analysis & Biz Reg =========
    
    shop_trust_scores {
        bigint id PK
        bigint shop_id FK "unique, NOT NULL, ON DELETE CASCADE"
        decimal tech_risk "0~1"
        decimal review_risk "0~1"
        int report_penalty "0~15"
        int final_trust "0~100"
        string trust_grade "VERY_HIGH|HIGH|CAUTION|LOW|VERY_LOW"
        string model_version
        timestamp analyzed_at
        timestamp created_at
        timestamp updated_at
    }
    
    ml_prediction_results {
        bigint id PK
        string url "NOT NULL"
        string normalized_url "NOT NULL"
        int label "0: SAFE, 1: PHISHING"
        decimal confidence "0~1"
        string requested_by
        string source "API|BATCH 등"
        timestamp created_at
    }
    %% 참고: ml_prediction_results는 shops와 직접 FK 관계 없음 (URL 기반)
    
    ai_analysis_cache {
        bigint id PK
        bigint shop_id FK "NOT NULL, ON DELETE CASCADE"
        string analysis_type "NOT NULL, RISK_ANALYSIS|BUSINESS_ANALYSIS|WEB_ANALYSIS 등"
        text analysis_result "NOT NULL, JSON 형태"
        timestamp analysis_date
        timestamp expires_at "NOT NULL"
        timestamp created_at
    }
    
    web_analysis {
        bigint id PK
        bigint shop_id FK "NOT NULL, ON DELETE CASCADE"
        text suspicious_keywords "JSON 형태"
        text price_analysis "JSON 형태"
        text technical_analysis "JSON 형태"
        text domain_analysis "JSON 형태"
        timestamp analysis_date
        string analysis_source "default: AUTO, AUTO|MANUAL"
        int confidence_score "default: 0, 0-100"
        timestamp created_at
    }
    
    business_registrations {
        bigint id PK
        bigint shop_id FK "NOT NULL, ON DELETE CASCADE"
        string business_number
        date registration_date
        string business_status "default: UNKNOWN, ACTIVE|SUSPENDED|CLOSED|UNKNOWN"
        string business_type
        bigint capital_amount
        string representative_name
        text business_address
        string phone_number
        string email
        timestamp last_verified
        string verification_source "default: MANUAL, API|MANUAL|CRAWLING"
        timestamp created_at
        timestamp updated_at
    }
    
    %% ========= Relationships =========
    
    %% Users & Auth
    users ||--o{ password_reset_tokens : "has"
    users ||--o{ user_login_logs : "has"
    
    %% Shops & Reports/Ratings
    shops ||--o{ shops : "parent_shop"
    shops ||--o{ shop_search_logs : "searched"
    users }o--o{ shop_search_logs : "searches"
    shops ||--o{ reports : "has"
    users }o--o{ reports : "reports"
    shops ||--o{ ratings : "has"
    users }o--o{ ratings : "rates"
    reports ||--o{ uploaded_files : "has"
    
    %% SMS
    users }o--o{ sms_verifications : "has"
    users }o--o{ sms_request_tracking : "requests"
    sms_request_tracking ||--o{ sms_verifications : "generates"
    
    %% Community
    users ||--o{ community_posts : "writes"
    community_posts ||--o{ community_comments : "has"
    users ||--o{ community_comments : "comments"
    community_posts ||--o{ community_post_likes : "has"
    users ||--o{ community_post_likes : "likes"
    
    %% Analysis & Biz Reg
    shops ||--|| shop_trust_scores : "has"
    shops ||--o{ ai_analysis_cache : "has"
    shops ||--o{ web_analysis : "has"
    shops ||--o{ business_registrations : "has"
    %% 참고: ml_prediction_results는 shops와 직접 FK 관계 없음 (URL 기반 매칭)
