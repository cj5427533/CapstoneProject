{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "frontend",
      "rootDirectory": "my-react-app",
      "buildCommand": "npm ci && npm run build",
      "startCommand": "npm run start",
      "envVars": {
        "PORT": "5173"
      }
    },
    {
      "name": "backend",
      "rootDirectory": "my-react-app/backend",
      "buildCommand": "npm ci",
      "startCommand": "npm start"
    }
  ]
}


